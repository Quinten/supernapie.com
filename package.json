{
  "name": "supernapie.com",
  "version": "0.0.1",
  "description": "Supernapie commercial website",
  "main": "src/index.js",
  "scripts": {
    "build": "webpack --mode production && node generateSitemap.js",
    "start": "webpack-dev-server --mode development",
    "postbuild": "react-snap"
  },
  "reactSnap": {
    "source": "pub",
    "minifyHtml": {
      "collapseWhitespace": false,
      "removeComments": false
    },
    "skipThirdPartyRequests": true,
    "include": [
      "/",
      "/games",
      "/blog"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quinten/supernapie.com.git"
  },
  "author": "Quinten Clause",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Quinten/supernapie.com/issues"
  },
  "homepage": "/",
  "devDependencies": {
    "ajv": "^6.2.1",
    "babel-cli": "^6.26.0",
    "babel-core": "^6.26.0",
    "babel-loader": "^7.1.4",
    "babel-preset-env": "^1.6.1",
    "babel-preset-react": "^6.24.1",
    "babel-webpack-plugin": "^0.1.1",
    "clean-webpack-plugin": "^2.0.1",
    "copy-webpack-plugin": "^5.0.2",
    "css-loader": "^0.28.11",
    "extract-text-webpack-plugin": "^4.0.0-beta.0",
    "less": "^3.9.0",
    "less-loader": "^4.1.0",
    "react-snap": "^1.23.0",
    "terser-webpack-plugin": "^1.2.3",
    "webpack": "^4.27.1",
    "webpack-cli": "^2.0.12",
    "webpack-dev-server": "^3.1.10"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.17",
    "@fortawesome/free-brands-svg-icons": "^5.8.1",
    "@fortawesome/free-solid-svg-icons": "^5.8.1",
    "babel-polyfill": "^6.26.0",
    "react": "^16.2.0",
    "react-dom": "^16.2.0",
    "react-helmet": "^5.2.0",
    "react-mailchimp-subscribe": "^2.0.2",
    "react-markdown": "^3.3.0",
    "react-router-dom": "^4.2.2",
    "whatwg-fetch": "^2.0.4"
  }
}
